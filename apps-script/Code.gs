function setup(){const p=PropertiesService.getScriptProperties();['SUPABASE_URL','SUPABASE_SECRET_KEY','ADMIN_EMAIL'].forEach(k=>{if(!p.getProperty(k))throw new Error(k+' が未設定です')});ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='syncSupport').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('syncSupport').timeBased().everyMinutes(5).create();syncSupport()}
function syncSupport(){notifyNewTickets_();importGmailReplies_()}
function settings_(){const p=PropertiesService.getScriptProperties();return{url:p.getProperty('SUPABASE_URL'),key:p.getProperty('SUPABASE_SECRET_KEY'),email:p.getProperty('ADMIN_EMAIL')}}
function request_(path,method,body,extraHeaders){const s=settings_(),o={method:method||'get',muteHttpExceptions:true,contentType:'application/json',headers:Object.assign({apikey:s.key,Authorization:'Bearer '+s.key},extraHeaders||{})};if(body!==undefined)o.payload=JSON.stringify(body);const r=UrlFetchApp.fetch(s.url+'/rest/v1/'+path,o);if(r.getResponseCode()>=300)throw new Error(r.getResponseCode()+': '+r.getContentText());return r.getContentText()?JSON.parse(r.getContentText()):null}
function notifyNewTickets_(){const s=settings_(),tickets=request_('tickets?admin_notified=eq.false&select=id,public_id,user_email,subject,created_at&order=created_at.asc&limit=20');tickets.forEach(t=>{const m=request_('ticket_messages?ticket_id=eq.'+encodeURIComponent(t.id)+'&sender=eq.user&select=body&order=created_at.asc&limit=1'),body=m.length?m[0].body:'本文を取得できませんでした。';MailApp.sendEmail({to:s.email,replyTo:t.user_email,subject:'[Meeting Canvas #'+t.public_id+'] '+t.subject,body:'Meeting Canvasから新しいお問い合わせです。\\n\\n'+body+'\\n\\nこのメールへ返信すると、返信内容がアプリにも表示されます。',htmlBody:'<h2>Meeting Canvasから新しいお問い合わせ</h2><p><b>チケット:</b> #'+t.public_id+'</p><p><b>送信者:</b> '+escapeHtml_(t.user_email)+'</p><p style="white-space:pre-wrap">'+escapeHtml_(body)+'</p><hr><p>このメールへ返信すると、返信内容がアプリにも表示されます。</p>'});request_('tickets?id=eq.'+encodeURIComponent(t.id),'patch',{admin_notified:true},{Prefer:'return=minimal'})})}
function importGmailReplies_(){const s=settings_(),threads=GmailApp.search('in:sent subject:"[Meeting Canvas #" newer_than:30d',0,100);threads.forEach(th=>th.getMessages().forEach(m=>{const match=m.getSubject().match(/\[Meeting Canvas #([A-Z0-9]{8})\]/);if(!match||m.getTo().indexOf(s.email)!==-1)return;const t=request_('tickets?public_id=eq.'+encodeURIComponent(match[1])+'&select=id,user_email&limit=1');if(!t.length||m.getTo().indexOf(t[0].user_email)===-1)return;try{request_('ticket_messages','post',{ticket_id:t[0].id,sender:'admin',body:cleanReply_(m.getPlainBody()),external_id:'gmail:'+m.getId(),created_at:m.getDate().toISOString()},{Prefer:'return=minimal'})}catch(e){if(String(e).indexOf('duplicate key')===-1)throw e}}))}
function cleanReply_(text){const lines=text.split('\\n'),kept=[];for(const line of lines){if(/^On .+wrote:$/.test(line)||/^20\\d\\d.+:$/.test(line)||/^>/.test(line))break;kept.push(line)}return kept.join('\\n').trim().slice(0,5000)||'返信が届きました。'}
function escapeHtml_(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
